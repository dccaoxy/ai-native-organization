  "interface": {
    "command": {
      "actor": "authenticated adapter identity; simulation selector in M01 only",
      "command": "authority_matrix key",
      "data": "public fields only",
      "idempotency_key": "required unique key bound to entire command"
    },
    "query": [
      "state",
      "events",
      "task_wall",
      "execution"
    ],
    "errors": [
      "400 invalid input",
      "403 authority violation",
      "409 stale state or idempotency conflict",
      "503 HUMAN_DECISION_REQUIRED for real mode"
    ]
  },
  "parameters": {
    "ack_timeout_seconds": {
      "default": 300,
      "classification": "Tunable",
      "evidence": "engineering test default, not experimentally validated"
    },
    "progress_timeout_seconds": {
      "default": 3600,
      "classification": "Tunable",
      "evidence": "engineering test default, not experimentally validated"
    }
  },
  "invariants": [
    "Task != Execution",
    "Exactly one Human Accountable Owner per Execution",
    "One active Agent interface per Human",
    "No private thought or draft collection",
    "Boundary expansion requires Human authorization",
    "Success/failure/release require formal Return",
    "Review != Acceptance != Selection",
    "One append-only Organizational Event Trail",
    "Runtime interruption is visible and recoverable"
  ],
  "pages": [
    "Identity and bindings",
    "Goal activation",
    "Task Wall publish/browse/claim",
    "Execution status, boundary request, return",
    "Human review/acceptance/selection",
    "Event trail and runtime interruption"
  ],
  "non_goals": [
    "Real external systems",
    "Human Pilot evidence",
    "Agent intelligence",
    "Private work capture"
  ]
