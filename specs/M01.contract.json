  "state_machines": {
    "Task": {
      "publish": {
        "from": [
          "draft"
        ],
        "to": "published"
      },
      "select": {
        "from": [
          "published"
        ],
        "to": "closed"
      }
    },
    "Execution": {
      "ack": {
        "from": [
          "claimed"
        ],
        "to": "running"
      },
      "progress": {
        "from": [
          "running"
        ],
        "to": "running"
      },
      "blocked": {
        "from": [
          "running"
        ],
        "to": "blocked"
      },
      "escalate": {
        "from": [
          "running",
          "blocked",
          "interrupted"
        ],
        "to": "blocked"
      },
      "resume": {
        "from": [
          "blocked",
          "interrupted"
        ],
        "to": "running"
      },
      "submit": {
        "from": [
          "running",
          "blocked",
          "interrupted"
        ],
        "to": "submitted"
      },
      "fail": {
        "from": [
          "claimed",
          "running",
          "blocked",
          "interrupted"
        ],
        "to": "failed"
      },
      "release": {
        "from": [
          "claimed",
          "running",
          "blocked",
          "interrupted"
        ],
        "to": "released"
      },
      "interrupt": {
        "from": [
          "claimed",
          "running",
          "blocked"
        ],
        "to": "interrupted"
      },
      "close": {
        "from": [
          "submitted",
          "failed",
          "released"
        ],
        "to": "closed"
      }
    }
  },
  "authority_matrix": {
    "register_human": "simulation bootstrap only; real identity requires authenticated adapter",
    "bind_agent": "the represented Human",
    "agent_status": "represented Human or currently bound Agent",
    "activate_goal": "explicit Human Goal Authority",
    "create_task": "Goal Authority",
    "publish": "Goal Authority",
    "claim": "HAU Human or active Representative Agent with claim permission",
    "ack": "Execution accountable Human or active delegated Agent",
    "progress": "Execution owner or active delegated Agent",
    "blocked": "Execution owner or active delegated Agent",
    "escalate": "Execution owner or active delegated Agent",
    "resume": "Execution owner or active delegated Agent; no pending BoundaryRequest",
    "request_boundary": "Execution owner or active delegated Agent; no expansion yet",
    "decide_boundary": "Goal Human Authority explicitly accepts requested/modified scope",
    "submit": "Execution owner or active delegated Agent; structured Return required",
    "fail": "Execution owner or active delegated Agent; structured Return required",
    "release": "Execution owner or active delegated Agent; structured Return required",
    "annotate_return": "Execution accountable Human; append Confirm/Correct/Add",
    "review": "Task review_authority; credibility judgment with evidence",
    "accept": "Task acceptance_authority; reviewed Return and intended-use rationale",
    "select": "Task selection_authority; accepted credible successful Return",
    "sweep": "simulation control plane using configured timeout; records interruption only"
